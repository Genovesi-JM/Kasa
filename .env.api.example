# Server-only configuration. Never expose these values through VITE_ variables.
KASA_API_HOST=127.0.0.1
KASA_API_PORT=8787
KASA_API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
KASA_API_COUNTRY=demo
KASA_API_DEMO_WRITES=false
# Required only when demo writes are explicitly enabled. Replace with a long local secret.
KASA_API_DEMO_KEY=
# Optional local account development only. Refused in production or on public binds.
# Use invented test details; business workflows remain synthetic.
KASA_API_LOCAL_ACCOUNTS=false
# Absolute path OUTSIDE this project, in a dedicated private local directory.
KASA_API_ACCOUNT_DB=
# Optional AES-256-GCM key to encrypt private documents at rest. 32 bytes as
# 64 hex chars or base64 (e.g. `openssl rand -hex 32`). Leave empty to store
# new documents in the clear. Keep this secret and out of version control.
KASA_API_DOCUMENT_KEY=
